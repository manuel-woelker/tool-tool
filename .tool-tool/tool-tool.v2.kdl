tools {
// cf. https://github.com/lsd-rs/lsd
	lsd "0.17.0" {
		download {
			linux "https://github.com/Peltoche/lsd/releases/download/${version}/lsd-${version}-x86_64-unknown-linux-gnu.tar.gz"
			windows "https://github.com/Peltoche/lsd/releases/download/${version}/lsd-${version}-x86_64-pc-windows-msvc.zip"
		}
		commands {
			lsd "lsd" description="List directory contents"
		}
		env {
		}
	}
	/*
	node "22.19.0" {
		download {
			windows "https://nodejs.org/dist/v${version}/node-v${version}-win-x64.zip"
		}
		commands {
			node "node"
			npm "npm"
			npm "npm"
			npx "npx"
		}
		env {
			foo "bar"
		}
	}
	lua "5.4.6" {
		download {
			// TODO: set strip_directories = 0
			windows "https://github.com/DevelopersCommunity/cmake-lua/releases/download/v${version}/Lua-${version}-win64.zip"
		}
		commands {
			lua "lua"
			luav "lua -v"
			luax #"lua -e "print('Hello World!')""#
		}
	}
	bun "1.2.21" {
		download {
			windows "https://github.com/oven-sh/bun/releases/download/bun-v${version}/bun-windows-x64-baseline.zip"
		}
		commands {
			bun "bun"
		}
	}
	*/
	node "24.13.0" {
		download {
			windows "https://nodejs.org/dist/v${version}/node-v${version}-win-x64.zip"
			linux "https://nodejs.org/dist/v${version}/node-v${version}-linux-x64.tar.gz"
		}
		commands {
			node "${linux:bin/}node"
			npm "${linux:bin/}npm"
			npx "${linux:bin/}npx"
		}
	}
	pnpm "12.2.1" {
		download {
			windows "https://github.com/pnpm/pnpm/releases/download/v${version}/pnpm-win32-x64.zip"
			linux "https://github.com/pnpm/pnpm/releases/download/v${version}/pnpm-linux-x64-musl.tar.gz"
		}
		commands {
			pnpm "pnpm"
		}
	}
	rust "1.98.0" {
	    download {
	        linux "https://static.rust-lang.org/dist/rust-${version}-x86_64-unknown-linux-gnu.tar.gz"
	    }
		commands {
			cargo "cargo/bin/cargo"
			rustc "rustc/bin/rustc"
		}
	}
	// https://adoptium.net/temurin/releases/
	java "26.0.2.1+1" {
		download {
			linux "https://github.com/adoptium/temurin26-binaries/releases/download/jdk-26.0.2.1%2B1/OpenJDK26U-jdk_x64_linux_hotspot_26.0.2.1_1.tar.gz"
			windows "https://github.com/adoptium/temurin26-binaries/releases/download/jdk-26.0.2.1%2B1/OpenJDK26U-jdk_x64_windows_hotspot_26.0.2.1_1.zip"
			macos "https://github.com/adoptium/temurin26-binaries/releases/download/jdk-26.0.2.1%2B1/OpenJDK26U-jdk_x64_mac_hotspot_26.0.2.1_1.tar.gz"
		}
		commands {
			java "${macos:Contents/Home/}bin/java${windows:.exe}"
			javac "${macos:Contents/Home/}bin/javac${windows:.exe}"
		}
	}
	// https://gradle.org/releases/
	gradle "9.7.1" {
		download {
			default "https://services.gradle.org/distributions/gradle-9.7.1-bin.zip"
		}
		commands {
			gradle "bin/gradle${windows:.bat}"
		}
		env {
			JAVA_HOME "${dir:java}${macos:/Contents/Home}"
		}
	}
}
